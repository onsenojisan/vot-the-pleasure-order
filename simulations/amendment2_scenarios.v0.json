{
  "schema_version": "0.1-draft",
  "status": "author-ratification draft",
  "generated_on": "2026-08-15",
  "registry_ready_for_locked_validation": false,
  "common_contract": {
    "state_model": "controlled continuous-Gaussian state space",
    "observation_model": "y_t ~ Normal(H*x_t + d, Sigma_y)",
    "vfe": "E_q[log q(x_1:T) - log p(y_1:T,x_1:T|a_1:T,u_1:T)]",
    "efe": "sum_tau KL[Q(y_tau|pi)||P_C(y_tau)] + E_Q H[p(y_tau|x_tau)]",
    "policy": "p(pi) proportional_to exp(-gamma*G(pi))*P_E(pi)",
    "primary_score": "held-out joint log predictive density per decision occasion",
    "action_stream_required_for_d5": true,
    "external_forcing_must_be_separate_from_action": true
  },
  "models": {
    "R0": {
      "name": "descriptive and generic state-space baseline suite",
      "truth_family": "BASELINE_ONLY",
      "dynamics": "intercept, trend, variance, autoregressive and generic state-space baselines"
    },
    "R1": {
      "name": "smooth changing equilibrium",
      "truth_family": "NON_FOLD",
      "dynamics": "x_next=b+A*x+B*a+U*u+w"
    },
    "R2": {
      "name": "externally forced jump",
      "truth_family": "NON_FOLD",
      "dynamics": "x_next=b+A*x+B*a+U*u+J*I(t>=t_jump)+w"
    },
    "S0": {
      "name": "non-bifurcation state switching",
      "truth_family": "NON_FOLD",
      "dynamics": "z_next~Markov(P); x_next=b_z+A_z*x+B_z*a+U_z*u+w"
    },
    "R3": {
      "name": "person-arm-specific active inference",
      "truth_family": "NON_FOLD",
      "sharing": "none across people or arms",
      "dynamics": "x_i,r,t+1=b_i,r+A_i,r*x_i,r,t+B_i,r*a_i,r,t+U_i,r*u_i,r,t+w"
    },
    "R4": {
      "name": "hierarchical active inference",
      "truth_family": "NON_FOLD",
      "sharing": "partial pooling learned from training partition",
      "dynamics": "theta_i,r~Normal(mu_group+Z_i,r*beta,Sigma_group); linear transition"
    },
    "R5": {
      "name": "shared decline-recovery active inference",
      "truth_family": "NON_FOLD",
      "sharing": "dynamics, observation, preference and policy parameters shared across arms",
      "dynamics": "linear transition; arm-specific initial state and observed forcing only"
    },
    "R6": {
      "name": "nonlinear hysteretic active inference",
      "truth_family": "FOLD",
      "sharing": "hierarchical across people and shared across arms",
      "dynamics": "x_next=x+delta*(alpha*x-x^3+beta*u+zeta*a)+w"
    }
  },
